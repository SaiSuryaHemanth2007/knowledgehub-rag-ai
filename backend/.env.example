# ======================
# Application
# ======================
APP_NAME=KnowledgeHub RAG AI
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise-grade Retrieval-Augmented Generation (RAG) platform.

# ======================
# Environment
# ======================
ENVIRONMENT=development
DEBUG=True

# ======================
# Server
# ======================
HOST=0.0.0.0
PORT=8000

# ======================
# Database
# ======================
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/knowledgehub

# ======================
# Security
# ======================
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# AI Providers
# ======================
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ======================
# Logging
# ======================
LOG_LEVEL=INFO